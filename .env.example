# Copy this file to .env and fill in real values for production.
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=archaeologist
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=code_archaeologist
DATABASE_URL=postgresql+asyncpg://archaeologist:change-me-in-production@localhost:5432/code_archaeologist

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External AI/provider settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
NEXT_PUBLIC_API_URL=http://localhost:8000
